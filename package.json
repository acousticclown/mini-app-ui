{
  "name": "@shivansh/mini-app-ui",
  "version": "0.2.0",
  "description": "Shared UI kit for Shivansh's Mini Apps — Stub Ledger tokens, Loader, EmptyStage, Button, TextLink, Select, Sheet",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react --external react-dom && cp src/styles/tokens.css dist/styles.css",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acousticclown/mini-app-ui.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
